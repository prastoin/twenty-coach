{
  "name": "coach-twenty-monorepo",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "^24.5.0",
    "npm": "please-use-yarn",
    "yarn": ">=4.0.2"
  },
  "packageManager": "yarn@4.13.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "twenty": "yarn workspace coach-twenty twenty",
    "lint": "oxlint -c .oxlintrc.json .",
    "lint:fix": "oxlint --fix -c .oxlintrc.json .",
    "typecheck": "yarn workspaces foreach -A --exclude coach-twenty-monorepo run typecheck",
    "test": "yarn workspace coach-twenty test",
    "test:watch": "yarn workspace coach-twenty test:watch",
    "test:unit": "yarn workspace coach-twenty test:unit",
    "pwa:dev": "yarn workspace @coach-twenty/trainee-pwa dev",
    "pwa:build": "yarn workspace @coach-twenty/trainee-pwa build",
    "schema:types": "yarn workspace coach-twenty schema:types"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@typescript/native-preview": "^7.0.0-dev.20260116.1",
    "oxlint": "^0.16.0",
    "typescript": "^5.9.3"
  }
}
