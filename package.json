{
  "name": "coach-twenty",
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "node": "^24.5.0",
    "npm": "please-use-yarn",
    "yarn": ">=4.0.2"
  },
  "keywords": [],
  "packageManager": "yarn@4.13.0",
  "scripts": {
    "twenty": "twenty",
    "lint": "oxlint -c .oxlintrc.json .",
    "lint:fix": "oxlint --fix -c .oxlintrc.json .",
    "typecheck": "tsgo --noEmit -p tsconfig.spec.json && tsgo --noEmit -p pwa/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "pwa:dev": "vite --config pwa/vite.config.ts",
    "pwa:build": "vite build --config pwa/vite.config.ts"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19",
    "@typescript/native-preview": "^7.0.0-dev.20260116.1",
    "@vitejs/plugin-react": "^6.0.5",
    "oxlint": "^0.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "twenty-client-sdk": "2.26.0",
    "twenty-sdk": "2.26.0",
    "twenty-ui": "1.0.0-alpha.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vite-tsconfig-paths": "^4.2.1",
    "vitest": "^4.0.0"
  }
}
